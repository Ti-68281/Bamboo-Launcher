{
  "name": "bamboo-launcher",
  "version": "1.0.1",
  "description": "Bamboo 竹启动器 — 简洁、通透、丝滑的 Minecraft Java 版启动器",
  "main": "./out/main/index.js",
  "author": "Ti68281",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Ti-68281/Bamboo-Launcher.git"
  },
  "homepage": "https://bamboo.xbkjz.icu/",
  "bugs": {
    "url": "https://github.com/Ti-68281/Bamboo-Launcher/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package:win": "electron-vite build && electron-builder --win --x64",
    "package:dir": "electron-vite build && electron-builder --dir --win --x64",
    "package:portable": "electron-vite build && node scripts/package-portable.mjs"
  },
  "dependencies": {
    "@xmcl/core": "2.13.0",
    "@xmcl/installer": "5.4.0",
    "@xmcl/user": "4.4.2",
    "adm-zip": "^0.5.16",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "@electron/asar": "^4.3.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "37",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.bamboo.launcher",
    "productName": "Bamboo",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Bamboo-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Bamboo 启动器"
    },
    "portable": {
      "artifactName": "Bamboo-Portable-${version}.${ext}"
    }
  }
}
